{
  // Configuration for markdownlint-cli2
  // See: https://github.com/DavidAnson/markdownlint-cli2

  // Ignore patterns - exclude dependencies, caches, build output, and the
  // changelog that semantic-release generates on every release
  "ignores": [
    "**/node_modules/**",
    "**/.venv/**",
    "**/.pytest_cache/**",
    "**/dist/**",
    "**/build/**",
    "CHANGELOG.md",
  ],

  // Extend base markdownlint config
  "config": {
    // Extend from .markdownlint.jsonc in the same directory
    "extends": ".markdownlint.jsonc",
  },
}
